# Copy this file to server/.env and fill in your key.
# Never commit the real .env file.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# 127.0.0.1 keeps the API on this computer. Use 0.0.0.0 only on a network you trust.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/inbox.db
LOG_LEVEL=info
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.15
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200
